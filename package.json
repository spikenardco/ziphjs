{
	"name": "ziphjs",
	"version": "0.0.1",
	"description": "Lightweight server-side JavaScript and TypeScript client for sending WhatsApp and SMS messages with Ziph.",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js",
			"default": "./src/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"src",
		"types"
	],
	"scripts": {
		"format": "biome check --write .",
		"format:check": "biome check .",
		"typecheck": "tsc && tsc --module ESNext --moduleResolution bundler",
		"prepublishOnly": "npm run format:check && npm run typecheck"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spikenardco/ziphjs.git"
	},
	"keywords": [
		"ziph",
		"whatsapp",
		"sms",
		"messaging",
		"sdk",
		"nodejs",
		"typescript"
	],
	"license": "Apache-2.0",
	"contributors": [
		{
			"name": "Ben",
			"email": "bnjox@users.noreply.github.com",
			"url": "https://github.com/bnjox"
		}
	],
	"bugs": {
		"url": "https://github.com/spikenardco/ziphjs/issues"
	},
	"homepage": "https://github.com/spikenardco/ziphjs#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.4.1",
		"typescript": "^7.0.2"
	}
}
